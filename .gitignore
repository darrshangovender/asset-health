# --- Data / models / logs ---
# Downloaded datasets and trained artefacts stay out of git, but small YAML
# fixtures under data/ are part of the repo (CI reads them), so keep those.
/data/*
!data/*.yml
!data/*.yaml
# the shipped RUL model (trained on SYNTHETIC development seeds) is part of the package
!asset_health/data/
!asset_health/data/rul_model.json
*.csv
*.parquet
*.pkl
*.joblib
*.h5
mlruns/
logs/
*.log

# --- Benchmarks ---
# benchmarks/results.json is committed: every README number traces to it.
benchmarks/.cache/

# --- Generated datasets (regenerate with `asset-health simulate`) ---
/out/
/demo/

# --- Docker ---
docker-compose.override.yml

# --- Misc ---
tmp/
.scratch/

